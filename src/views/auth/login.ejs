<div class="max-w-md mx-auto py-12 animate-fadeIn">
  <!-- Judul -->
  <div class="text-center mb-8">
    <div class="w-16 h-16 rounded-2xl bg-indigo-600/20 flex items-center justify-center mx-auto mb-4">
      <i class="fas fa-sign-in-alt text-2xl text-indigo-400"></i>
    </div>
    <h1 class="text-2xl font-bold text-white">Masuk ke Akun</h1>
    <p class="text-sm text-slate-400 mt-1">
      Belum punya akun?
      <a href="/register" class="text-indigo-400 hover:text-indigo-300">Daftar di sini</a>
    </p>
  </div>

  <!-- Form login -->
  <div class="glass-card">
    <form method="POST" action="/login" class="space-y-5">
      <div>
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" class="form-input" placeholder="nama@email.com" autocomplete="email"
          required autofocus>
      </div>

      <div>
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••"
          autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn-primary w-full py-3 text-base">
        <i class="fas fa-sign-in-alt"></i> Masuk
      </button>
    </form>
  </div>
</div>