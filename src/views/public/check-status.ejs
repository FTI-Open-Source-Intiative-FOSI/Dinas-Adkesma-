<div class="max-w-xl mx-auto py-8 animate-fadeIn">
  <div class="text-center mb-10">
    <div class="w-16 h-16 rounded-2xl bg-indigo-600/20 flex items-center justify-center mx-auto mb-4">
      <i class="fas fa-search text-2xl text-indigo-400"></i>
    </div>
    <h1 class="text-3xl font-bold text-white mb-3">Cek Status Laporan</h1>
    <p class="text-slate-400">Masukkan kode tiket untuk melihat status laporan kamu</p>
  </div>

  <div class="glass-card">
    <form method="POST" action="/check" class="flex gap-3">
      <input type="text" name="ticket_code" class="form-input flex-1"
             placeholder="Contoh: LPR-20261024-A7K2"
             value="<%= typeof ticket_code !== 'undefined' ? ticket_code : '' %>"
             required>
      <button type="submit" class="btn btn-primary flex-shrink-0">
        <i class="fas fa-search"></i> Cari
      </button>
    </form>
  </div>

  <% if (searched) { %>
    <div class="mt-6 animate-fadeIn">
      <% if (report) { %>
        <div class="glass-card">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-white"><%= report.title %></h2>
            <%- include('../partials/status-badge', { status: report.status }) %>
          </div>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
              <span class="text-slate-500">Kode Tiket</span>
              <p class="text-indigo-300 font-mono font-semibold"><%= report.ticket_code %></p>
            </div>
            <div>
              <span class="text-slate-500">Kategori</span>
              <p class="text-slate-300"><%= report.category_name %></p>
            </div>
            <div>
              <span class="text-slate-500">Tanggal Laporan</span>
              <p class="text-slate-300"><%= new Date(report.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            </div>
            <div>
              <span class="text-slate-500">Status Terakhir</span>
              <p class="text-slate-300"><%= report.status.charAt(0).toUpperCase() + report.status.slice(1) %></p>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="glass-card text-center py-8">
          <i class="fas fa-search text-3xl text-slate-600 mb-3"></i>
          <p class="text-slate-400">Laporan dengan kode tiket tersebut tidak ditemukan.</p>
          <p class="text-sm text-slate-500 mt-1">Pastikan kode tiket yang kamu masukkan benar.</p>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
