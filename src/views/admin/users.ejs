<%
  // URL halaman daftar yang mempertahankan pencarian & filter saat pindah halaman
  const pageUrl = function (p) {
    const params = new URLSearchParams();
    if (filters.search) params.set('search', filters.search);
    if (filters.role)   params.set('role', filters.role);
    if (p > 1) params.set('page', String(p));
    const qs = params.toString();
    return '/admin/users' + (qs ? '?' + qs : '');
  };
  const hasFilter = Boolean(filters.search || filters.role);
%>
<div class="animate-fadeIn space-y-6">

    <!-- Ringkasan (klik kartu untuk memfilter) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/admin/users" class="glass-card block transition-transform hover:-translate-y-0.5">
            <p class="text-xs text-slate-400">Total pengguna</p>
            <p class="text-2xl font-bold text-white mt-1"><%= stats.total %></p>
        </a>
        <a href="/admin/users?role=mahasiswa" class="glass-card block transition-transform hover:-translate-y-0.5">
            <p class="text-xs text-slate-400">Mahasiswa</p>
            <p class="text-2xl font-bold text-emerald-400 mt-1"><%= stats.mahasiswa %></p>
        </a>
        <a href="/admin/users?role=admin" class="glass-card block transition-transform hover:-translate-y-0.5">
            <p class="text-xs text-slate-400">Admin</p>
            <p class="text-2xl font-bold text-indigo-400 mt-1"><%= stats.admin %></p>
        </a>
    </div>

    <!-- Pencarian & filter -->
    <div class="glass-card">
        <form method="GET" action="/admin/users" class="flex flex-wrap gap-3 items-end">
            <div class="flex-1 min-w-[200px]">
                <label class="form-label">Cari</label>
                <input type="text" name="search" class="form-input" placeholder="Nama, email, atau NIM..."
                    value="<%= filters.search %>">
            </div>
            <div class="w-40">
                <label class="form-label">Role</label>
                <select name="role" class="form-select">
                    <option value="">Semua</option>
                    <option value="mahasiswa" <%= filters.role === 'mahasiswa' ? 'selected' : '' %>>Mahasiswa</option>
                    <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Cari</button>
            <% if (hasFilter) { %>
                <a href="/admin/users" class="btn btn-secondary btn-sm">Reset</a>
            <% } %>
        </form>
    </div>

    <!-- Daftar pengguna -->
    <div class="glass-card">
        <h2 class="text-lg font-semibold text-white mb-4">
            <i class="fas fa-users mr-2 text-slate-400"></i> Daftar Pengguna
            <span class="text-sm font-normal text-slate-500 ml-2">
                (<%= total %> <%= hasFilter ? 'sesuai filter' : 'total' %>)
            </span>
        </h2>

        <% if (users && users.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Pengguna</th>
                            <th>NIM</th>
                            <th>Prodi</th>
                            <th>Role</th>
                            <th>Laporan</th>
                            <th>Terdaftar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function (u) { %>
                            <tr>
                                <td>
                                    <p class="font-medium text-white"><%= u.name %></p>
                                    <p class="text-xs text-slate-400"><%= u.email %></p>
                                </td>
                                <td class="text-xs"><%= u.nim || '-' %></td>
                                <td class="text-xs"><%= u.prodi || '-' %></td>
                                <td>
                                    <% if (u.role === 'admin') { %>
                                        <span class="text-xs font-semibold text-indigo-400">
                                            <i class="fas fa-user-shield mr-1"></i>Admin
                                        </span>
                                    <% } else { %>
                                        <span class="text-xs text-slate-300">
                                            <i class="fas fa-user-graduate mr-1"></i>Mahasiswa
                                        </span>
                                    <% } %>
                                </td>
                                <td class="text-xs"><%= u.role === 'admin' ? '-' : u.report_count %></td>
                                <td class="text-xs whitespace-nowrap">
                                    <%= new Date(u.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <p class="text-xs text-slate-500 mt-4">
                <i class="fas fa-info-circle mr-1"></i>
                Kolom Laporan tidak menghitung laporan anonim, demi menjaga identitas pelapor.
            </p>

            <!-- Paginasi -->
            <% if (totalPages > 1) { %>
                <div class="flex justify-center mt-6">
                    <div class="pagination">
                        <% if (page > 1) { %>
                            <a href="<%= pageUrl(page - 1) %>"><i class="fas fa-chevron-left"></i></a>
                        <% } %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === page) { %>
                                <span class="active"><%= i %></span>
                            <% } else { %>
                                <a href="<%= pageUrl(i) %>"><%= i %></a>
                            <% } %>
                        <% } %>
                        <% if (page < totalPages) { %>
                            <a href="<%= pageUrl(page + 1) %>"><i class="fas fa-chevron-right"></i></a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } else { %>
            <p class="text-sm text-slate-400 text-center py-8">
                <%= hasFilter ? 'Tidak ada pengguna yang cocok dengan pencarian atau filter ini.' : 'Belum ada pengguna.' %>
            </p>
        <% } %>
    </div>
</div>