
<div class="animate-fadeIn">

  <!-- Filters -->
  <div class="glass-card mb-6">
    <form method="GET" action="/admin/reports"
          class="flex flex-wrap gap-3 items-end">

      <div class="flex-1 min-w-[200px]">
        <label class="form-label">Cari</label>
        <input
          type="text"
          name="search"
          class="form-input"
          placeholder="Judul atau kode tiket..."
          value="<%= filters.search %>">
      </div>

      <div class="w-40">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="">Semua</option>

          <% statuses.forEach(function(s) { %>
            <option
              value="<%= s %>"
              <%= filters.status === s ? 'selected' : '' %>>
              <%= s.charAt(0).toUpperCase() + s.slice(1) %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="w-48">
        <label class="form-label">Kategori</label>
        <select name="category_id" class="form-select">
          <option value="">Semua</option>

          <% categories.forEach(function(cat) { %>
            <option
              value="<%= cat.id %>"
              <%= String(filters.category_id) === String(cat.id) ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">
        <i class="fas fa-search"></i>
        Filter
      </button>

      <a href="/admin/reports" class="btn btn-secondary btn-sm">
        Reset
      </a>
    </form>
  </div>

  <!-- Reports Table -->
  <div class="glass-card">

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-white">
        <i class="fas fa-file-alt mr-2 text-slate-400"></i>
        Daftar Laporan
        <span class="text-sm font-normal text-slate-500 ml-2">
          (<%= total %> total)
        </span>
      </h2>
    </div>

    <% if (reports && reports.length > 0) { %>

      <div class="overflow-x-auto">
        <table class="data-table">

          <thead>
            <tr>
              <th>Tiket</th>
              <th>Judul</th>
              <th>Pelapor</th>
              <th>Kategori</th>
              <th>Status</th>
              <th>Tanggal</th>
              <th class="text-center">Aksi</th>
            </tr>
          </thead>

          <tbody>
            <% reports.forEach(function(r) { %>
              <tr>

                <td>
                  <span class="font-mono text-indigo-400 text-xs">
                    <%= r.ticket_code %>
                  </span>
                </td>

                <td class="max-w-[200px] truncate font-medium text-white">
                  <%= r.title %>
                </td>

                <td>
                  <%= r.reporter_name %>
                </td>

                <td class="text-xs">
                  <%= r.category_name %>
                </td>

                <td>
                  <%- include('../partials/status-badge', { status: r.status }) %>
                </td>

                <td class="text-xs whitespace-nowrap">
                  <%= new Date(r.created_at).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  }) %>
                </td>

                <!-- Action Buttons -->
                <td>
                  <div class="flex flex-wrap items-center justify-center gap-2">

                    <!-- Detail Button -->
                    <a
                      href="/admin/reports/<%= r.id %>"
                      class="inline-flex items-center justify-center gap-2
                             px-4 py-2 rounded-xl
                             border border-slate-500/60
                             bg-slate-500/20 text-white font-semibold
                             whitespace-nowrap
                             hover:bg-slate-500/40
                             transition duration-200">

                      <i class="fas fa-eye"></i>
                      <span>Detail</span>
                    </a>

                    <!-- Delete Button -->
                    <form
                      method="POST"
                      action="/admin/reports/<%= r.id %>/delete"
                      class="inline-flex"
                      onsubmit="return confirm(
                        'Yakin ingin menghapus laporan ini? Data laporan dan riwayat terkait juga akan dihapus.'
                      );">

                      <button
                        type="submit"
                        class="inline-flex items-center justify-center gap-2
                               px-4 py-2 rounded-xl
                               border border-red-500/40
                               bg-red-600 text-white font-semibold
                               whitespace-nowrap
                               hover:bg-red-700
                               transition duration-200">

                        <i class="fas fa-trash-alt"></i>
                        <span>Hapus Data</span>
                      </button>

                    </form>

                  </div>
                </td>

              </tr>
            <% }); %>
          </tbody>

        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="flex justify-center mt-6">
          <div class="pagination">

            <% if (page > 1) { %>
              <a href="/admin/reports?<%= new URLSearchParams({
                page: String(page - 1),
                status: filters.status || '',
                category_id: filters.category_id || '',
                search: filters.search || ''
              }).toString() %>"
                 aria-label="Halaman sebelumnya">
                <i class="fas fa-chevron-left"></i>
              </a>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>

              <% if (i === page) { %>
                <span class="active"><%= i %></span>
              <% } else { %>
                <a href="/admin/reports?<%= new URLSearchParams({
                  page: String(i),
                  status: filters.status || '',
                  category_id: filters.category_id || '',
                  search: filters.search || ''
                }).toString() %>">
                  <%= i %>
                </a>
              <% } %>

            <% } %>

            <% if (page < totalPages) { %>
              <a href="/admin/reports?<%= new URLSearchParams({
                page: String(page + 1),
                status: filters.status || '',
                category_id: filters.category_id || '',
                search: filters.search || ''
              }).toString() %>"
                 aria-label="Halaman berikutnya">
                <i class="fas fa-chevron-right"></i>
              </a>
            <% } %>

          </div>
        </div>
      <% } %>

    <% } else { %>

      <p class="text-sm text-slate-400 text-center py-8">
        Tidak ada laporan yang ditemukan.
      </p>

    <% } %>

  </div>
</div>
