<div class="max-w-3xl mx-auto animate-fadeIn">
  <div class="mb-6">
    <a href="/student/reports" class="text-sm text-slate-400 hover:text-white transition-colors">
      <i class="fas fa-arrow-left mr-1"></i> Kembali ke Riwayat
    </a>
  </div>

  <!-- Report Header -->
  <div class="glass-card mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <span class="text-xs font-mono text-indigo-400 bg-indigo-600/20 px-2 py-0.5 rounded"><%= report.ticket_code %></span>
        <h1 class="text-xl font-bold text-white mt-2"><%= report.title %></h1>
      </div>
      <%- include('../partials/status-badge', { status: report.status }) %>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm mb-6">
      <div>
        <span class="text-slate-500 text-xs">Kategori</span>
        <p class="text-slate-300"><%= report.category_name %></p>
      </div>
      <div>
        <span class="text-slate-500 text-xs">Tanggal Kejadian</span>
        <p class="text-slate-300"><%= new Date(report.incident_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
      </div>
      <% if (report.incident_location) { %>
        <div>
          <span class="text-slate-500 text-xs">Lokasi</span>
          <p class="text-slate-300"><%= report.incident_location %></p>
        </div>
      <% } %>
      <% if (report.reported_party) { %>
        <div>
          <span class="text-slate-500 text-xs">Pihak Dilaporkan</span>
          <p class="text-slate-300"><%= report.reported_party %></p>
        </div>
      <% } %>
    </div>

    <div class="border-t border-white/10 pt-4">
      <h2 class="text-sm font-semibold text-slate-400 mb-2">Deskripsi</h2>
      <p class="text-sm text-slate-300 whitespace-pre-line leading-relaxed"><%= report.description %></p>
    </div>
  </div>

  <!-- Attachments -->
  <% if (report.attachments && report.attachments.length > 0) { %>
    <div class="glass-card mb-6">
      <h2 class="text-base font-semibold text-white mb-4"><i class="fas fa-paperclip mr-2 text-slate-400"></i> Lampiran</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% report.attachments.forEach(function(att) { %>
          <a href="/uploads/<%= att.file_path %>" target="_blank"
             class="flex items-center gap-3 p-3 rounded-xl bg-white/5 hover:bg-white/10 transition-colors group">
            <div class="w-10 h-10 rounded-lg bg-indigo-600/20 flex items-center justify-center flex-shrink-0">
              <% if (att.mime_type.startsWith('image/')) { %>
                <i class="fas fa-image text-indigo-400"></i>
              <% } else { %>
                <i class="fas fa-file-alt text-indigo-400"></i>
              <% } %>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-white truncate group-hover:text-indigo-300 transition-colors"><%= att.original_name %></p>
              <p class="text-xs text-slate-500"><%= (att.file_size / 1024).toFixed(1) %> KB</p>
            </div>
            <i class="fas fa-download text-slate-600 group-hover:text-indigo-400"></i>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Status Timeline -->
  <% if (report.statusLogs && report.statusLogs.length > 0) { %>
    <div class="glass-card mb-6">
      <h2 class="text-base font-semibold text-white mb-4"><i class="fas fa-history mr-2 text-slate-400"></i> Riwayat Status</h2>
      <div class="ml-2">
        <% report.statusLogs.forEach(function(log) { %>
          <div class="timeline-item">
            <div class="flex items-center gap-2 mb-1">
              <%- include('../partials/status-badge', { status: log.new_status }) %>
              <span class="text-xs text-slate-500">
                <%= new Date(log.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
            </div>
            <% if (log.note) { %>
              <p class="text-sm text-slate-400"><%= log.note %></p>
            <% } %>
            <p class="text-xs text-slate-600">Oleh: <%= log.changed_by_name %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Admin Responses -->
  <% 
    const visibleResponses = report.responses ? report.responses.filter(function(r) { return !r.is_internal; }) : [];
  %>
  <% if (visibleResponses.length > 0) { %>
    <div class="glass-card">
      <h2 class="text-base font-semibold text-white mb-4"><i class="fas fa-comment-dots mr-2 text-slate-400"></i> Tanggapan</h2>
      <div class="space-y-4">
        <% visibleResponses.forEach(function(resp) { %>
          <div class="p-4 rounded-xl bg-indigo-600/10 border border-indigo-500/20">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-7 h-7 rounded-full bg-indigo-600/30 flex items-center justify-center">
                <i class="fas fa-user-shield text-indigo-300 text-xs"></i>
              </div>
              <span class="text-sm font-medium text-white"><%= resp.admin_name %></span>
              <span class="text-xs text-slate-500"><%= new Date(resp.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
            <p class="text-sm text-slate-300 whitespace-pre-line"><%= resp.message %></p>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>
