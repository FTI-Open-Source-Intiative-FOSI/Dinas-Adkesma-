<div class="animate-fadeIn">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Riwayat Laporan</h1>
      <p class="text-sm text-slate-400 mt-1">Daftar semua laporan yang pernah kamu kirim</p>
    </div>
    <a href="/student/reports/new" class="btn btn-primary">
      <i class="fas fa-plus"></i> Buat Laporan
    </a>
  </div>

  <% if (reports && reports.length > 0) { %>
    <div class="space-y-4">
      <% reports.forEach(function(r) { %>
        <a href="/student/reports/<%= r.id %>" class="glass-card block hover:border-indigo-500/30 transition-all duration-300 group">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-mono text-indigo-400 bg-indigo-600/20 px-2 py-0.5 rounded"><%= r.ticket_code %></span>
                <%- include('../partials/status-badge', { status: r.status }) %>
              </div>
              <h2 class="text-base font-semibold text-white group-hover:text-indigo-300 transition-colors truncate"><%= r.title %></h2>
              <div class="flex items-center gap-4 mt-2 text-xs text-slate-500">
                <span><i class="fas fa-folder mr-1"></i> <%= r.category_name %></span>
                <span><i class="fas fa-calendar mr-1"></i> <%= new Date(r.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
            </div>
            <i class="fas fa-chevron-right text-slate-600 group-hover:text-indigo-400 transition-colors mt-3"></i>
          </div>
        </a>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="flex justify-center mt-8">
        <div class="pagination">
          <% if (page > 1) { %>
            <a href="/student/reports?page=<%= page - 1 %>"><i class="fas fa-chevron-left"></i></a>
          <% } %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === page) { %>
              <span class="active"><%= i %></span>
            <% } else { %>
              <a href="/student/reports?page=<%= i %>"><%= i %></a>
            <% } %>
          <% } %>
          <% if (page < totalPages) { %>
            <a href="/student/reports?page=<%= page + 1 %>"><i class="fas fa-chevron-right"></i></a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } else { %>
    <div class="glass-card text-center py-16">
      <div class="w-20 h-20 rounded-2xl bg-indigo-600/10 flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-file-alt text-3xl text-indigo-400/50"></i>
      </div>
      <h2 class="text-lg font-semibold text-white mb-2">Belum Ada Laporan</h2>
      <p class="text-sm text-slate-400 mb-6">Kamu belum pernah mengirim laporan. Buat laporan pertamamu sekarang.</p>
      <a href="/student/reports/new" class="btn btn-primary">
        <i class="fas fa-plus"></i> Buat Laporan Pertama
      </a>
    </div>
  <% } %>
</div>
