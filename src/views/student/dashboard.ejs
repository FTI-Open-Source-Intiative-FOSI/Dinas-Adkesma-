<div class="animate-fadeIn">
  <h1 class="text-2xl font-bold text-white mb-2">Selamat datang, <%= currentUser ? currentUser.name : '' %>!</h1>
  <p class="text-slate-400 mb-8">Lihat riwayat laporan atau buat laporan baru.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <a href="/student/reports/new" class="glass-card text-center py-12 hover:border-indigo-500/30 transition-all duration-300 group">
      <div class="w-16 h-16 rounded-2xl bg-indigo-600/20 flex items-center justify-center mx-auto mb-4 group-hover:bg-indigo-600/30 transition-colors">
        <i class="fas fa-plus text-2xl text-indigo-400"></i>
      </div>
      <h2 class="text-lg font-semibold text-white">Buat Laporan Baru</h2>
      <p class="text-sm text-slate-400 mt-1">Kirim pengaduan atau laporan masalah</p>
    </a>

    <a href="/student/reports" class="glass-card text-center py-12 hover:border-purple-500/30 transition-all duration-300 group">
      <div class="w-16 h-16 rounded-2xl bg-purple-600/20 flex items-center justify-center mx-auto mb-4 group-hover:bg-purple-600/30 transition-colors">
        <i class="fas fa-file-alt text-2xl text-purple-400"></i>
      </div>
      <h2 class="text-lg font-semibold text-white">Riwayat Laporan</h2>
      <p class="text-sm text-slate-400 mt-1">Lihat semua laporan yang pernah kamu kirim</p>
    </a>
  </div>
</div>
