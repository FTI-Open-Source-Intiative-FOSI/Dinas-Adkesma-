<div class="flex flex-col items-center justify-center py-24 animate-fadeIn">
  <div class="w-24 h-24 rounded-full bg-indigo-600/20 flex items-center justify-center mb-6">
    <i class="fas fa-exclamation-triangle text-4xl text-indigo-400"></i>
  </div>
  <h1 class="text-4xl font-bold text-white mb-3"><%= typeof title !== 'undefined' ? title : 'Error' %></h1>
  <p class="text-slate-400 text-center max-w-md mb-8"><%= typeof message !== 'undefined' ? message : 'Terjadi kesalahan.' %></p>
  <a href="/" class="btn btn-primary">
    <i class="fas fa-home"></i> Kembali ke Beranda
  </a>
</div>
