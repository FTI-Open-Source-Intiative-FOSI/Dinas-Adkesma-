<% if (typeof flashMessages !== 'undefined' && flashMessages && flashMessages.length > 0) { %>
  <div class="space-y-2 mb-6">
    <% flashMessages.forEach(function(msg) { %>
      <div class="flash-message flash-<%= msg.type %>" id="flash-<%= Date.now() %>">
        <% if (msg.type === 'success') { %>
          <i class="fas fa-check-circle"></i>
        <% } else if (msg.type === 'error') { %>
          <i class="fas fa-exclamation-circle"></i>
        <% } else if (msg.type === 'warning') { %>
          <i class="fas fa-exclamation-triangle"></i>
        <% } else { %>
          <i class="fas fa-info-circle"></i>
        <% } %>
        <span><%= msg.message %></span>
        <button onclick="this.parentElement.remove()" class="ml-auto text-current opacity-60 hover:opacity-100">
          <i class="fas fa-times"></i>
        </button>
      </div>
    <% }); %>
  </div>
  <script>
    setTimeout(function() {
      document.querySelectorAll('.flash-message').forEach(function(el) {
        el.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-10px)';
        setTimeout(function() { el.remove(); }, 300);
      });
    }, 5000);
  </script>
<% } %>
