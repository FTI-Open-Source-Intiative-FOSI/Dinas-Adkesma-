# Salin file ini menjadi .env lalu sesuaikan nilainya
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lapor_mahasiswa

# Ganti dengan string acak yang panjang
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang

# Upload lampiran
UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_FILES=3
